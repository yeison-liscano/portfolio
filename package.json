{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "eslint": "eslint",
    "eslint:fix": "eslint . --config eslint.config.js --fix",
    "cy:eslint": "eslint 'e2e/specs/*.ts' --config e2e/eslint.config.js",
    "cy:eslint::fix": "eslint 'e2e/specs/*.ts' --config e2e/eslint.config.js --fix",
    "format:check": "prettier --check .",
    "format::write": "prettier --write .",
    "format:markdown": "prettier --write --ignore-path .prettierignore \"src/blog/**/*.{md,mdx}\"",
    "test": "vitest --config vitest.config.js --watch=false --coverage",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "globals": "^17.12.0",
    "markdown-it": "15.0.2",
    "rehype-external-links": "^3.0.0",
    "remark-toc": "^9.0.0",
    "sanitize-html": "2.17.7",
    "satori": "^0.33.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.70.1",
    "astro-eslint-parser": "3.2.0",
    "cypress": "16.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-mdx": "3.8.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "remark-frontmatter": "^5.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "fflate": "^0.8.3"
  }
}
