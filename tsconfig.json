{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "paths": {
      "components/*": ["./src/components/*"],
      "layouts/*": ["./src/layouts/*"],
      "pages/*": ["./src/pages/*"]
    }
  },
  "include": ["**/*.ts", "**/*.js", "**/*.mjs", "**/*.astro", "**/*.md"],
  "exclude": [".astro", "dist", "e2e", "node_modules"]
}
