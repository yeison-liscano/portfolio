---
import { getCollection } from "astro:content";

const { BASE_URL } = import.meta.env;
const articleCount = (await getCollection("blog", ({ data }) => !data.isDraft))
  .length;

const proof = [
  {
    label: "Now",
    text: "AI & Security Engineer at Fluid Attacks, building a production AI agent platform with MCP and PydanticAI.",
  },
  {
    label: "Open source",
    text: "Author of http-mcp, a stateless MCP server library published on PyPI.",
    href: "https://pypi.org/project/http-mcp/",
  },
  {
    label: "Writing",
    text: `${articleCount} articles on MCP, security, Python and algorithms.`,
    href: `${BASE_URL}blog/`,
  },
];
---

<section class="hero-section">
  <div class="hero-main">
    <p class="eyebrow animate" style="--delay: 0ms">
      AI & Security Engineer · Medellín, Colombia
    </p>
    <h1 class="animate" style="--delay: 60ms">
      Yeison Liscano
    </h1>
    <p class="lead animate" style="--delay: 120ms">
      I build secure AI agent platforms and the Python tooling behind them.
    </p>
    <p class="detail animate" style="--delay: 180ms">
      My work spans MCP servers, PydanticAI agents, GraphQL APIs, React
      frontends and AWS infrastructure, with security designed in from the
      start.
    </p>
    <div class="hero-actions animate" style="--delay: 240ms">
      <a href="#projects" class="btn btn-primary">
        See projects
      </a>
      <a href={`${BASE_URL}blog/`} class="btn btn-secondary">
        Read the blog
      </a>
    </div>
  </div>

  <ul class="proof animate" style="--delay: 300ms" aria-label="Highlights">
    {proof.map((item) => (
      <li>
        <span class="proof-label">{item.label}</span>
        {item.href ? (
          <a href={item.href}>{item.text}</a>
        ) : (
          <span class="proof-text">{item.text}</span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .hero-section {
    min-height: 85vh;
    display: grid;
    grid-template-columns: 1fr;
    align-content: center;
    gap: 48px;
    padding: 40px 0;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
  }

  .eyebrow {
    margin: 0;
    color: var(--contrast);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--text-color);
    font-size: 2.75rem;
    line-height: 1.1;
  }

  .lead {
    margin: 0;
    color: var(--text-color);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .detail {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* ===== BUTTONS ===== */
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 28px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn:focus-visible {
    outline: 2px solid var(--contrast);
    outline-offset: 2px;
  }

  .btn-primary {
    border: 1px solid var(--contrast);
    background-color: var(--contrast);
    color: var(--primary);
  }

  .btn-primary:hover {
    background-color: transparent;
    color: var(--contrast);
  }

  .btn-secondary {
    border: 1px solid var(--line);
    background-color: transparent;
    color: var(--text-color);
  }

  .btn-secondary:hover {
    border-color: var(--contrast);
    color: var(--contrast);
  }

  /* ===== PROOF POINTS ===== */
  .proof {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background-color: var(--surface);
    list-style: none;
  }

  .proof li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px;
  }

  .proof li + li {
    border-top: 1px solid var(--line);
  }

  .proof-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proof-text,
  .proof a {
    color: var(--text-color);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .proof a:hover {
    color: var(--contrast);
  }

  .proof a:focus-visible {
    outline: 2px solid var(--contrast);
    outline-offset: 2px;
  }

  /* ===== RESPONSIVE ===== */
  @media screen and (min-width: 600px) {
    .hero-actions {
      flex-direction: row;
    }

    .btn {
      width: auto;
      min-width: 160px;
    }
  }

  @media screen and (min-width: 720px) {
    h1 {
      font-size: 3.5rem;
    }

    .lead {
      font-size: 1.6rem;
    }
  }

  @media screen and (min-width: 1100px) {
    .hero-section {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      gap: 56px;
    }

    h1 {
      font-size: 4rem;
    }
  }
</style>
