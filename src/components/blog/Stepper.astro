---
/**
 * Stepper - Walks the reader through a diagram one step at a time.
 *
 * Mark elements inside the slot with data-step="N" (1-based). While step N is
 * shown, elements of earlier steps stay visible, elements of step N are
 * highlighted, and later ones fade out. Without JavaScript the whole diagram
 * and every step's text are visible, so the figure is complete at rest.
 */
interface Props {
  /** One short sentence per step, in order. */
  steps: string[];
  /** Name shown to screen readers, e.g. "TLS handshake steps". */
  label: string;
}

const { steps, label } = Astro.props;
---

<blog-stepper data-total={steps.length}>
  <div class="stepper-stage">
    <slot />
  </div>
  <ol class="stepper-steps">
    {steps.map((step, index) => (
      <li value={index + 1}>{step}</li>
    ))}
  </ol>
  <div class="stepper-controls" role="group" aria-label={label} hidden>
    <button type="button" data-action="prev">
      Previous
    </button>
    <span class="stepper-count" aria-live="polite"></span>
    <button type="button" data-action="next">
      Next
    </button>
  </div>
</blog-stepper>

<script>
  class BlogStepper extends HTMLElement {
    private current = 1;

    connectedCallback() {
      const controls = this.querySelector<HTMLElement>(".stepper-controls");
      if (!controls) return;
      controls.hidden = false;
      this.classList.add("is-enhanced");
      controls.addEventListener("click", (event) => {
        const action = (event.target as HTMLElement)
          .closest("button")
          ?.getAttribute("data-action");
        if (action === "prev") this.show(this.current - 1);
        if (action === "next") this.show(this.current + 1);
      });
      this.show(1);
    }

    private get total(): number {
      return Number(this.dataset.total ?? "1");
    }

    show(step: number) {
      this.current = Math.min(Math.max(step, 1), this.total);
      this.querySelectorAll<Element>("[data-step]").forEach((element) => {
        const own = Number(element.getAttribute("data-step"));
        const state =
          own < this.current
            ? "past"
            : own === this.current
              ? "current"
              : "future";
        element.setAttribute("data-state", state);
      });
      this.querySelectorAll(".stepper-steps li").forEach((item, index) => {
        item.toggleAttribute("data-current", index + 1 === this.current);
      });
      const count = this.querySelector(".stepper-count");
      if (count) count.textContent = `Step ${this.current} of ${this.total}`;
      const [prev, next] = this.querySelectorAll("button");
      prev.disabled = this.current === 1;
      next.disabled = this.current === this.total;
    }
  }

  customElements.define("blog-stepper", BlogStepper);
</script>

<style>
  blog-stepper {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stepper-steps {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding-left: 1.5rem;
    font-size: 0.95rem;
  }

  .is-enhanced .stepper-steps li {
    display: none;
  }

  .is-enhanced .stepper-steps li[data-current] {
    display: list-item;
  }

  .is-enhanced :global([data-step]) {
    transition:
      opacity 0.25s ease,
      color 0.25s ease,
      stroke 0.25s ease;
  }

  .is-enhanced :global([data-state="future"]) {
    opacity: 0.12;
  }

  .is-enhanced :global([data-state="current"]) {
    color: var(--contrast);
  }

  .stepper-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stepper-count {
    min-width: 7rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  button {
    padding: 4px 14px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background-color: transparent;
    color: var(--text-color);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }

  button:hover:not(:disabled) {
    border-color: var(--contrast);
    color: var(--contrast);
  }

  button:focus-visible {
    outline: 2px solid var(--contrast);
    outline-offset: 2px;
  }

  button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .is-enhanced :global([data-step]) {
      transition: none;
    }
  }
</style>
