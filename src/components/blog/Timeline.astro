---
/**
 * Timeline - Tasks laid out on a shared time axis, drawn at build time.
 *
 * Each group is one scenario (for example "one thread" vs "three threads").
 * Rows hold segments of work: `cpu` (filled), `wait` (outlined, waiting on
 * I/O) and `queue` (dotted, waiting for a free worker). The finish time of
 * each group is the accent, so scenarios compare at a glance.
 */
type Kind = "cpu" | "wait" | "queue";

interface Segment {
  start: number;
  end: number;
  kind: Kind;
}

interface Row {
  label: string;
  segments: Segment[];
}

interface Group {
  title: string;
  rows: Row[];
}

interface Props {
  groups: Group[];
  /** Axis maximum, in `unit`. */
  max: number;
  /** Distance between axis ticks, in `unit`. */
  tick: number;
  unit: string;
  /** Screen-reader summary of what the timeline shows. */
  label: string;
  /** Legend text per segment kind; only kinds listed here are shown. */
  legend: Partial<Record<Kind, string>>;
}

const { groups, max, tick, unit, label, legend } = Astro.props;

const W = 640;
const LABEL_W = 132;
const PLOT_W = W - LABEL_W - 64;
const ROW_H = 14;
const ROW_GAP = 8;
const TITLE_H = 24;
const GROUP_GAP = 22;

const x = (value: number) => LABEL_W + (value / max) * PLOT_W;

const laidOut = groups.reduce<{ top: number; group: Group; end: number }[]>(
  (acc, group) => {
    const previous = acc[acc.length - 1];
    const top = previous
      ? previous.top +
        TITLE_H +
        previous.group.rows.length * (ROW_H + ROW_GAP) +
        GROUP_GAP
      : 0;
    const end = Math.max(
      ...group.rows.flatMap((row) => row.segments.map((s) => s.end)),
    );
    return [...acc, { top, group, end }];
  },
  [],
);

const last = laidOut[laidOut.length - 1];
const axisY =
  last.top + TITLE_H + last.group.rows.length * (ROW_H + ROW_GAP) + 4;
const ticks = Array.from(
  { length: Math.floor(max / tick) + 1 },
  (_, i) => i * tick,
);
const legendEntries = Object.entries(legend) as [Kind, string][];
// Mono 11px is about 6.6px per character; each entry is swatch + text + gap.
const legendX = legendEntries.map((_, i) =>
  legendEntries
    .slice(0, i)
    .reduce((sum, [, text]) => sum + 30 + text.length * 6.6 + 24, 0),
);
const legendY = axisY + 40;
const H = legendY + 12;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} class="timeline">
  {
    laidOut.map(({ top, group, end }) => (
      <g transform={`translate(0 ${top})`}>
        <text x="0" y="14" class="title">
          {group.title}
        </text>
        {group.rows.map((row, r) => {
          const y = TITLE_H + r * (ROW_H + ROW_GAP);
          return (
            <g>
              <text x="0" y={y + ROW_H / 2} class="row-label">
                {row.label}
              </text>
              <line
                x1={LABEL_W}
                x2={x(max)}
                y1={y + ROW_H / 2}
                y2={y + ROW_H / 2}
                class="track"
              />
              {row.segments.map((s) => (
                <rect
                  x={x(s.start)}
                  y={y}
                  width={x(s.end) - x(s.start)}
                  height={ROW_H}
                  rx="2"
                  class={s.kind}
                />
              ))}
            </g>
          );
        })}
        <line
          x1={x(end)}
          x2={x(end)}
          y1={TITLE_H - 4}
          y2={TITLE_H + group.rows.length * (ROW_H + ROW_GAP) - 4}
          class="finish"
        />
        <text
          x={x(end) + 6}
          y={TITLE_H + ((ROW_H + ROW_GAP) * group.rows.length) / 2 - 4}
          class="finish-label"
        >
          {end} {unit}
        </text>
      </g>
    ))
  }

  <line x1={LABEL_W} x2={x(max)} y1={axisY} y2={axisY} class="axis"></line>
  {
    ticks.map((t) => (
      <g>
        <line x1={x(t)} x2={x(t)} y1={axisY} y2={axisY + 4} class="axis" />
        <text x={x(t)} y={axisY + 16} class="tick">
          {t === max ? `${t} ${unit}` : t}
        </text>
      </g>
    ))
  }

  {
    legendEntries.map(([kind, text], i) => (
      <g transform={`translate(${legendX[i]} ${legendY - 10})`}>
        <rect x="0" y="0" width="22" height="12" rx="2" class={kind} />
        <text x="30" y="6" class="legend">
          {text}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .timeline {
    min-width: 560px;
    color: var(--text-color);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .title {
    fill: currentColor;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }

  .row-label,
  .legend {
    fill: currentColor;
    font-size: 11px;
    dominant-baseline: middle;
  }

  .track {
    stroke: var(--line);
    stroke-width: 1;
  }

  .cpu {
    fill: var(--text-color);
  }

  .wait {
    fill: var(--surface);
    stroke: var(--muted);
    stroke-width: 1.2;
  }

  .queue {
    fill: var(--surface);
    stroke: var(--muted);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
  }

  .finish {
    stroke: var(--contrast);
    stroke-width: 2;
  }

  .finish-label {
    fill: var(--contrast);
    font-size: 12px;
    font-weight: 600;
    dominant-baseline: middle;
  }

  .axis {
    stroke: var(--muted);
    stroke-width: 1;
  }

  .tick {
    fill: var(--muted);
    font-size: 10px;
    text-anchor: middle;
  }
</style>
