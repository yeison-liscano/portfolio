---
interface IHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: IHeading[];
}

// Sections and their subsections only; deeper levels make the list too long
// and too small to read.
const headings = Astro.props.headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
---

{headings.length > 0 && (
  <nav id="toc-aside" aria-labelledby="toc-title">
    <h2 class="toc-header">
      <button
        id="toc-toggle"
        class="toc-btn"
        aria-expanded="true"
        aria-controls="article-content"
      >
        <span id="toc-title">On this page</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="chevron"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </h2>
    <ul id="article-content" class="open">
      {headings.map((heading) => (
        <li class={`h-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const tocList = document.getElementById("article-content");
  const tocLinks = tocList?.querySelectorAll("a") ?? [];
  const desktop = window.matchMedia("(min-width: 1300px)");
  const isDesktop = () => desktop.matches;

  // Scroll-based active heading tracking
  const headingEls = Array.from(tocLinks)
    .map((link) => {
      const id = link.getAttribute("href")?.slice(1);
      return id ? document.getElementById(id) : null;
    })
    .filter(Boolean) as HTMLElement[];

  function updateActiveHeading() {
    if (!tocList) return;
    let activeId = "";

    for (const heading of headingEls) {
      if (heading.getBoundingClientRect().top <= 120) {
        activeId = heading.id;
      }
    }

    tocList.querySelectorAll("li").forEach((li) => {
      const link = li.querySelector("a");
      const href = link?.getAttribute("href")?.slice(1);
      if (href === activeId) {
        li.classList.add("active");
        link?.setAttribute("aria-current", "location");
        if (isDesktop()) {
          const aside = document.getElementById("toc-aside");
          if (
            aside &&
            (li.offsetTop < aside.scrollTop ||
              li.offsetTop + li.offsetHeight >
                aside.scrollTop + aside.clientHeight)
          ) {
            aside.scrollTop = li.offsetTop - aside.clientHeight / 2;
          }
        }
      } else {
        li.classList.remove("active");
        link?.removeAttribute("aria-current");
      }
    });
  }

  let ticking = false;
  window.addEventListener("scroll", () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateActiveHeading();
        ticking = false;
      });
      ticking = true;
    }
  });

  window.addEventListener("load", updateActiveHeading);

  // Collapsible below 1300px, where the list sits in the page. It starts
  // open: a collapsed table of contents is easy to miss. On desktop the list
  // is always shown, so the toggle is disabled there.
  const toggle = document.getElementById("toc-toggle") as HTMLButtonElement;
  const syncToggle = () => {
    if (!toggle) return;
    toggle.disabled = isDesktop();
    if (isDesktop()) tocList?.classList.add("open");
    toggle.setAttribute(
      "aria-expanded",
      String(tocList?.classList.contains("open") ?? false),
    );
  };
  desktop.addEventListener("change", syncToggle);
  syncToggle();

  toggle?.addEventListener("click", () => {
    if (isDesktop()) return;
    const isOpen = tocList?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });
</script>

<style>
  /* ===== MOBILE / TABLET (default) ===== */
  nav {
    width: 100%;
    margin-bottom: 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .toc-header {
    margin: 0;
    font-size: inherit;
  }

  .toc-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 16px;
    background-color: var(--secondary);
    border: none;
    color: var(--contrast);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
  }

  .toc-btn:hover .chevron {
    opacity: 1;
  }

  .chevron {
    color: var(--text-color);
    opacity: 0.6;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .toc-btn[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  ul.open {
    max-height: min(60vh, 600px);
    overflow-y: auto;
    padding: 8px 0;
  }

  li {
    margin-left: 0;
    padding: 8px 16px;
  }

  li.active {
    background-color: var(--contrast);
  }

  li.active a {
    color: var(--primary);
  }

  a {
    text-decoration: none;
    white-space: break-spaces;
    color: var(--text-color);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  a:hover {
    color: var(--contrast);
  }

  li:hover {
    background-color: var(--contrast);
  }

  li:hover a {
    color: var(--primary);
  }

  .h-3 {
    padding-left: 32px;
  }

  .h-3 a {
    font-size: 0.825rem;
  }

  /* ===== DESKTOP (≥1300px) ===== */
  @media (min-width: 1300px) {
    nav {
      position: fixed;
      right: 24px;
      top: 100px;
      width: 280px;
      max-height: calc(100vh - 200px);
      overflow-y: auto;
      padding: 20px 0;
      background: transparent;
      border: none;
      border-radius: 0;
      box-shadow: none;
      margin-bottom: 0;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    /* A right rail is easy to ignore: keep the label in full contrast. */
    .toc-btn {
      background: none;
      padding: 0 16px 12px;
      cursor: default;
      border-bottom: 1px solid var(--neutral);
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-color);
    }

    .chevron {
      display: none;
    }

    ul,
    ul.open {
      max-height: none;
      overflow: visible;
      padding: 8px 0;
      transition: none;
      border-left: 2px solid var(--neutral);
      margin-left: 16px;
    }

    li {
      padding: 6px 16px;
      border-radius: 0;
      margin-left: -2px;
      border-left: 2px solid transparent;
      transition: border-color 0.2s ease;
    }

    .h-3 {
      padding-left: 28px;
    }

    li:hover {
      background-color: transparent;
      border-left-color: var(--text-color);
    }

    li:hover a {
      color: var(--text-color);
    }

    li.active {
      background-color: transparent;
      border-left-color: var(--contrast);
    }

    li.active a {
      color: var(--contrast);
      font-weight: 600;
    }

    a,
    .h-3 a {
      font-size: 0.8rem;
      color: var(--muted);
      transition: color 0.2s ease;
    }
  }
</style>
