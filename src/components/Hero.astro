---
import type { CollectionEntry } from "astro:content";
import { formatDate, isoDate, label } from "../utils/format";

type Props = Pick<
  CollectionEntry<"blog">["data"],
  | "author"
  | "pubDate"
  | "updatedDate"
  | "readingTime"
  | "title"
  | "description"
  | "summary"
  | "tags"
>;

export type { Props };

const {
  author,
  pubDate,
  updatedDate,
  readingTime,
  title,
  description,
  summary,
  tags,
} = Astro.props;
const { BASE_URL } = import.meta.env;
// Only a later day counts as an update.
const showUpdated = updatedDate && isoDate(updatedDate) > isoDate(pubDate);
---

<div class="hero-container">
  <div class="hero-header">
    <h1>{title}</h1>
    <p class="description">{description}</p>
    <div class="hero-meta">
      <a class="author" href={`${BASE_URL}about/`} rel="author">
        {author}
      </a>
      <span class="dot" aria-hidden="true">
        ·
      </span>
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      {showUpdated && (
        <>
          <span class="dot" aria-hidden="true">
            ·
          </span>
          <span>
            Updated{" "}
            <time datetime={isoDate(updatedDate)}>
              {formatDate(updatedDate)}
            </time>
          </span>
        </>
      )}
      <span class="dot" aria-hidden="true">
        ·
      </span>
      <span class="reading-time">{readingTime}</span>
    </div>
    {tags.length > 0 && (
      <ul class="hero-tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <a href={`${BASE_URL}blog/?tag=${encodeURIComponent(tag)}`}>
              {label(tag)}
            </a>
          </li>
        ))}
      </ul>
    )}
    {summary && summary.length > 0 && (
      <aside class="key-takeaways" aria-labelledby="key-takeaways-title">
        <p id="key-takeaways-title">Key takeaways</p>
        <ul>
          {summary.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    )}
  </div>
  <div class="hero-content">
    <slot />
  </div>
</div>
<hr class="hero-divider" />

<style>
  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 0;
    gap: 24px;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .description {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 60ch;
    text-wrap: pretty;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 10px;
    row-gap: 4px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .author,
  .author:visited {
    color: var(--text-color);
    font-weight: 600;
  }

  .author:hover {
    color: var(--contrast);
  }

  .reading-time {
    color: var(--contrast);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-tags a,
  .hero-tags a:visited {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 9px;
  }

  .hero-tags a:hover {
    color: var(--contrast);
    border-color: var(--contrast);
  }

  .key-takeaways {
    width: 100%;
    max-width: 65ch;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--contrast);
    border-radius: 8px;
  }

  .key-takeaways p {
    margin-bottom: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--contrast);
  }

  .key-takeaways ul {
    margin: 0;
    padding-left: 1.2em;
    line-height: 1.6;
  }

  .key-takeaways li + li {
    margin-top: 6px;
  }

  .hero-content {
    width: 100%;
  }

  .hero-divider {
    width: 100%;
    border: none;
    border-top: 1px solid var(--line);
    margin: 0;
    opacity: 1;
  }

  @media screen and (min-width: 720px) {
    h1 {
      font-size: 3rem;
    }

    .hero-container {
      gap: 28px;
    }
  }

  @media screen and (min-width: 900px) {
    h1 {
      font-size: 3.5rem;
    }

    .hero-container {
      gap: 32px;
    }
  }
</style>
