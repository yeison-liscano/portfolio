---
// Same file the @font-face in base.css uses, so the preload is reused.
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** "article" for blog posts, so link previews treat them as articles. */
  type?: "website" | "article";
  /** ISO date of publication, for article previews. */
  publishedTime?: string;
  /** Page language; posts in Spanish or French set their own. */
  lang?: "en" | "es" | "fr";
  /** Preview image path relative to the site base; posts pass their own. */
  image?: string;
  /** Schema.org data for search engines, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  type = "website",
  publishedTime,
  lang = "en",
  image = "og-image.png",
  jsonLd,
} = Astro.props;

const OG_LOCALES = { en: "en_US", es: "es_CO", fr: "fr_FR" } as const;
const { BASE_URL } = import.meta.env;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const asset = (path: string) => `${BASE_URL}${path}`;
// Social platforms (LinkedIn, X, Slack) only render raster preview images.
const ogImage = new URL(asset(image), Astro.site).href;
const rssURL = new URL(asset("rss.xml"), Astro.site).href;
// Escape "<" so no string in the data can close the script element.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Yeison Liscano" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Body text font: fetch it early so text never renders in a fallback. -->
  <link
    rel="preload"
    href={geistLatin}
    as="font"
    type="font/woff2"
    crossorigin
  />

  <!-- Icons and app manifest -->
  <link rel="icon" href={asset("favicon.ico")} sizes="any" />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href={asset("favicon-32x32.png")}
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href={asset("favicon-16x16.png")}
  />
  <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
  <link rel="manifest" href={asset("manifest.webmanifest")} />
  <meta
    name="theme-color"
    content="#171c28"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#ffffff"
    media="(prefers-color-scheme: light)"
  />

  <!-- Discovery -->
  <link rel="sitemap" href={asset("sitemap-index.xml")} />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="Yeison Liscano"
    href={rssURL}
  />

  <!-- Open Graph -->
  <meta property="og:locale" content={OG_LOCALES[lang]} />
  <meta property="og:site_name" content="Yeison Liscano" />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta
    property="og:image:alt"
    content={
      type === "article" ? title : "Yeison Liscano, AI and Security Engineer"
    }
  />
  {type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}

  <!-- X (Twitter) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />
  <meta name="twitter:site" content="@yeison__liscano" />
  <meta name="twitter:creator" content="@yeison__liscano" />

  <!-- Structured data -->
  {jsonLdText && (
    <script is:inline type="application/ld+json" set:html={jsonLdText} />
  )}

  <script is:inline>
    const THEME_KEY = "theme";
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    const storedTheme = () => {
      try {
        return localStorage.getItem(THEME_KEY);
      } catch {
        return null;
      }
    };

    const getPreference = () =>
      storedTheme() ?? (media.matches ? "dark" : "light");

    /** @param {string} theme */
    const apply = (theme) =>
      document.documentElement.setAttribute("data-theme", theme);

    const toggle = () => {
      const current = document.documentElement.getAttribute("data-theme");
      const next = current === "dark" ? "light" : "dark";
      apply(next);
      try {
        localStorage.setItem(THEME_KEY, next);
      } catch {
        // Storage can be blocked; the choice then lasts for this page only.
      }
    };

    // Set the theme before first paint so the page never flashes the wrong one.
    apply(getPreference());

    // Follow the OS setting only while the reader has not chosen a theme.
    media.addEventListener("change", (event) => {
      if (!storedTheme()) apply(event.matches ? "dark" : "light");
    });

    Object.assign(window, { theme: { getPreference, toggle } });
  </script>
</head>
