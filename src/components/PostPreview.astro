---
import { formatDate, isoDate, label } from "../utils/format";

const { BASE_URL } = import.meta.env;

interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
  readingTime: string;
  pubDate: Date;
  dataTags?: string;
}

const { title, pubDate, description, tags, slug, readingTime, dataTags } =
  Astro.props;

const date = formatDate(pubDate);
const postUrl = `${BASE_URL}blog/${slug}/`;
---

<div class="preview-container visible" data-tags={dataTags}>
  <div class="description-container">
    <span class="label">Article</span>
    <h2>
      <a href={postUrl}>{title}</a>
    </h2>
    <div class="description-card">
      <p>{description}</p>
    </div>
    <div class="tags-container">
      {tags.map((tag) => (
        <button class="tag" data-filter-tag={tag} type="button">
          {label(tag)}
        </button>
      ))}
    </div>
    <div class="meta">
      <time datetime={isoDate(pubDate)}>{date}</time>
      <span class="separator">&middot;</span>
      <span>{readingTime}</span>
    </div>
  </div>
</div>

<style>
  .preview-container {
    width: 100%;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .description-container {
    min-width: 0;
  }
  .label {
    display: none;
  }
  h2 {
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }
  h2 a {
    color: var(--text-color);
  }
  h2 a:hover {
    color: var(--contrast);
  }
  .description-card p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 14px;
  }
  .tag {
    font: inherit;
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--line);
    background: transparent;
    border-radius: 6px;
    padding: 4px 9px;
    cursor: pointer;
  }
  .tag:hover {
    color: var(--contrast);
    border-color: var(--contrast);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
