---
/** A fictional account passes authentication, then gets two policy results. */
const id = "identity-access-decisions";
---

<svg
  viewBox="0 0 640 320"
  role="img"
  aria-label="Example: Ana’s authenticated account employee-1042 has profile:read. Reading her profile is allowed; reading the finance report is denied because finance:read is missing."
  class="diagram"
>
  <defs>
    <marker
      id={`${id}-arrow`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="context-stroke"></path>
    </marker>
  </defs>

  <text x="16" y="20" class="note">
    Fictional application policy
  </text>
  <rect x="16" y="40" width="608" height="68" rx="4" class="box"></rect>
  <text x="32" y="64" class="label">
    Authenticated account: employee-1042
  </text>
  <text x="32" y="88" class="note">
    Ana’s permissions: profile:read
  </text>

  <path
    d="M320,108 V132 H160 V156"
    marker-end={`url(#${id}-arrow)`}
    class="edge"
  ></path>
  <path
    d="M320,132 H480 V156"
    marker-end={`url(#${id}-arrow)`}
    class="edge"
  ></path>
  <text x="32" y="124" class="note">
    same account, separate requests
  </text>

  <rect x="16" y="160" width="288" height="76" rx="4" class="box"></rect>
  <text x="32" y="186" class="label">
    read own-profile
  </text>
  <text x="32" y="212" class="note">
    requires profile:read
  </text>
  <path d="M160,236 V264" marker-end={`url(#${id}-arrow)`} class="edge"></path>
  <text x="160" y="290" class="result">
    ALLOW: permission present
  </text>

  <g class="accent">
    <rect x="336" y="160" width="288" height="76" rx="4" class="box"></rect>
    <text x="352" y="186" class="label">
      read finance-report
    </text>
    <text x="352" y="212" class="detail">
      requires finance:read
    </text>
    <path
      d="M480,236 V264"
      marker-end={`url(#${id}-arrow)`}
      class="edge"
    ></path>
    <text x="480" y="290" class="result">
      DENY: permission missing
    </text>
  </g>
</svg>

<style>
  .diagram {
    min-width: 560px;
    color: var(--text-color);
    font-family: var(--font-mono);
  }

  .box {
    fill: var(--code-background);
    stroke: currentColor;
    stroke-width: 1;
  }

  .edge {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .label,
  .result,
  .detail {
    fill: currentColor;
    font-size: 12px;
  }

  .note {
    fill: var(--muted);
    font-size: 11px;
  }

  .result {
    text-anchor: middle;
  }

  .accent {
    color: var(--contrast);
  }
</style>
