---
/**
 * Grafo - Draws one or more small graphs (panels) in a single SVG.
 *
 * Shared by the "Teoría de grafos" series. Nodes render with data-node and
 * edges with data-edge="a-b", so explorables can set data-hl (accent),
 * data-dim or data-fill on them at runtime. Items with `step` are wrapped in
 * <g data-step> so the drawing also works inside <Stepper>.
 */
import { edgeGeometry, nodeRadius, type Panel } from "./geometria";

interface Props {
  panels: Panel[];
  width: number;
  height: number;
  /** aria-label: the claim the drawing makes. */
  label: string;
  /** Minimum rendered width in px, so dense drawings scroll on phones. */
  minWidth?: number;
  /** Maximum rendered width in px; defaults to 1.25 times the viewBox. */
  maxWidth?: number;
}

const { panels, width, height, label, minWidth, maxWidth } = Astro.props;
const uid = `grafo-${Math.random().toString(36).slice(2, 8)}`;
const arrow = `url(#${uid}-arrow)`;
const arrowHl = `url(#${uid}-arrow-hl)`;
const svgStyle = [
  minWidth ? `min-width: ${minWidth}px` : "",
  `max-width: ${maxWidth ?? Math.round(width * 1.25)}px`,
]
  .filter(Boolean)
  .join("; ");
const flag = (on: boolean | undefined) => (on ? "" : undefined);

const prepared = panels.map((panel) => {
  const style = panel.nodeStyle ?? "circle";
  const radius = nodeRadius(style);
  const byId = new Map(panel.nodes.map((node) => [node.id, node]));
  const edges = panel.edges.map((edge) => {
    const a = byId.get(edge.a);
    const b = byId.get(edge.b);
    if (!a || !b) {
      throw new Error(`[Grafo] edge ${edge.a}-${edge.b}: unknown vertex`);
    }
    return { edge, ...edgeGeometry(a, b, edge, radius) };
  });
  const titleX = panel.titleX ?? (panel.w ?? 0) / 2;
  const titleY = panel.titleY ?? (panel.h ?? 0) - 4;
  return { panel, style, radius, edges, titleX, titleY };
});
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={label}
  class="grafo"
  style={svgStyle}
>
  <defs>
    <marker
      id={`${uid}-arrow`}
      viewBox="0 0 10 10"
      refX="10"
      refY="5"
      markerWidth="9"
      markerHeight="9"
      markerUnits="userSpaceOnUse"
      orient="auto-start-reverse"
    >
      <path d="M0,1 L10,5 L0,9 z" fill="currentColor"></path>
    </marker>
    <marker
      id={`${uid}-arrow-hl`}
      viewBox="0 0 10 10"
      refX="10"
      refY="5"
      markerWidth="11"
      markerHeight="11"
      markerUnits="userSpaceOnUse"
      orient="auto-start-reverse"
    >
      <path class="g-arrow-hl" d="M0,1 L10,5 L0,9 z"></path>
    </marker>
  </defs>
  {prepared.map(({ panel, style, radius, edges, titleX, titleY }) => (
    <g transform={`translate(${panel.x ?? 0} ${panel.y ?? 0})`}>
      {edges.map(({ edge, d, lx, ly }) => (
        <g data-step={edge.step}>
          <g
            class="g-edge-group"
            data-edge={`${edge.a}-${edge.b}`}
            data-hl={flag(edge.hl)}
            data-ghost={flag(edge.ghost)}
            data-halo={flag(edge.halo)}
          >
            <path
              class="g-edge"
              d={d}
              marker-end={edge.dir ? (edge.hl ? arrowHl : arrow) : undefined}
            />
            {edge.w !== undefined && (
              <text class="g-w" x={lx} y={ly}>
                {edge.w}
              </text>
            )}
          </g>
        </g>
      ))}
      {panel.nodes
        .filter((node) => node.ring)
        .map((node) => (
          <g data-step={node.step}>
            <circle class="g-ring" cx={node.x} cy={node.y} r={radius + 6} />
          </g>
        ))}
      {panel.nodes.map((node) => (
        <g data-step={node.ring ? undefined : node.step}>
          <g
            class="g-node"
            data-node={node.id}
            data-hl={flag(node.hl)}
            data-ghost={flag(node.ghost)}
            data-fill={node.fill}
          >
            {style === "circle" ? (
              <>
                <circle class="g-circle" cx={node.x} cy={node.y} r={radius} />
                <text class="g-in" x={node.x} y={node.y}>
                  {node.label ?? node.id}
                </text>
              </>
            ) : (
              <>
                <circle class="g-dot" cx={node.x} cy={node.y} r={radius} />
                {(node.label ?? node.id) !== "" && (
                  <text
                    class="g-out"
                    x={node.x + (node.dx ?? 0)}
                    y={node.y + (node.dy ?? -12)}
                    text-anchor={node.anchor ?? "middle"}
                  >
                    {node.label ?? node.id}
                  </text>
                )}
              </>
            )}
            {node.note && (
              <text
                class="g-note"
                x={node.x + (node.noteDx ?? 0)}
                y={node.y + (node.noteDy ?? -22)}
                text-anchor={node.noteAnchor ?? "middle"}
              >
                {node.note}
              </text>
            )}
          </g>
        </g>
      ))}
      {(panel.labels ?? []).map((free) => (
        <text
          class="g-label"
          x={free.x}
          y={free.y}
          text-anchor={free.anchor ?? "middle"}
          data-hl={flag(free.hl)}
        >
          {free.text}
        </text>
      ))}
      {panel.title && (
        <text class="g-title" x={titleX} y={titleY}>
          {panel.title}
        </text>
      )}
    </g>
  ))}
</svg>

<style>
  .grafo {
    color: var(--text-color);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .g-edge {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    transition:
      stroke-width 0.2s ease,
      opacity 0.2s ease;
  }

  .g-edge-group,
  .g-node {
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .g-edge-group[data-hl] {
    color: var(--contrast);
  }

  .g-edge-group[data-hl] .g-edge {
    stroke-width: 3;
  }

  .g-arrow-hl {
    fill: var(--contrast);
  }

  .g-edge-group[data-halo] .g-edge {
    stroke-width: 9;
    stroke-opacity: 0.3;
  }

  [data-state="current"] > .g-edge-group[data-halo] .g-edge {
    stroke-opacity: 0.85;
  }

  .g-edge-group[data-ghost] {
    color: var(--muted);
  }

  .g-edge-group[data-ghost] .g-edge {
    stroke-dasharray: 4 4;
  }

  .g-edge-group[data-hl][data-ghost],
  .g-node[data-hl][data-ghost] {
    color: var(--contrast);
  }

  .g-edge-group[data-dim],
  .g-node[data-dim] {
    opacity: 0.25;
  }

  .g-w {
    fill: currentColor;
    font-size: 12px;
    text-anchor: middle;
    dominant-baseline: central;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .g-circle {
    fill: var(--code-background);
    stroke: currentColor;
    stroke-width: 1.5;
    transition:
      fill 0.2s ease,
      stroke-width 0.2s ease;
  }

  .g-dot {
    fill: currentColor;
  }

  .g-in {
    fill: currentColor;
    font-size: 12px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .g-out {
    fill: currentColor;
    font-size: 12px;
    dominant-baseline: central;
  }

  .g-note {
    fill: var(--muted);
    font-size: 11px;
    dominant-baseline: central;
  }

  .g-node[data-hl] {
    color: var(--contrast);
  }

  .g-node[data-hl] .g-circle {
    stroke-width: 3;
  }

  .g-node[data-hl] .g-note {
    fill: currentColor;
  }

  .g-node[data-ghost] {
    color: var(--muted);
  }

  .g-node[data-ghost] .g-circle {
    fill: none;
    stroke-dasharray: 3 3;
  }

  .g-node[data-ghost] .g-dot {
    fill: none;
    stroke: currentColor;
    stroke-dasharray: 2 2;
  }

  .g-node[data-fill="1"] .g-circle {
    fill: color-mix(in oklab, var(--cat-1) 30%, var(--surface));
    stroke: var(--cat-1);
    stroke-width: 2.5;
  }

  .g-node[data-fill="2"] .g-circle {
    fill: color-mix(in oklab, var(--cat-2) 30%, var(--surface));
    stroke: var(--cat-2);
    stroke-width: 2.5;
  }

  .g-node[data-fill="3"] .g-circle {
    fill: color-mix(in oklab, var(--cat-3) 30%, var(--surface));
    stroke: var(--cat-3);
    stroke-width: 2.5;
  }

  .g-node[data-fill="4"] .g-circle {
    fill: color-mix(in oklab, var(--cat-4) 30%, var(--surface));
    stroke: var(--cat-4);
    stroke-width: 2.5;
  }

  .g-label {
    fill: var(--muted);
    font-size: 11px;
    dominant-baseline: central;
  }

  .g-label[data-hl] {
    fill: var(--contrast);
  }

  .g-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-opacity: 0.35;
  }

  [data-state="current"] > .g-ring {
    stroke-width: 3;
    stroke-opacity: 1;
  }

  .g-title {
    fill: var(--muted);
    font-size: 12px;
    text-anchor: middle;
  }

  @media (prefers-reduced-motion: reduce) {
    .g-edge,
    .g-edge-group,
    .g-node,
    .g-circle {
      transition: none;
    }
  }
</style>
