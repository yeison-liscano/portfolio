---
/**
 * SampleToPopulation - Descriptive statistics summarize the sample in hand;
 * inferential statistics use it to estimate the unknown population mean.
 * Numbers come from the post's sample: [23, 45, 12, 67, 34, 89, 21].
 */
const id = "sample-population";
const SAMPLE = [23, 45, 12, 67, 34, 89, 21];
const T_975_DF6 = 2.447;

const n = SAMPLE.length;
const mean = SAMPLE.reduce((a, b) => a + b, 0) / n;
const s = Math.sqrt(
  SAMPLE.reduce((acc, v) => acc + (v - mean) ** 2, 0) / (n - 1),
);
const margin = (T_975_DF6 * s) / Math.sqrt(n);
const [low, high] = [mean - margin, mean + margin];

// Population: a 10 x 8 grid of people; the sample picks 7 of them.
const COLS = 10;
const ROWS = 8;
const PICKED = new Set([3, 14, 27, 38, 45, 59, 72]);

const AX0 = 312;
const AX1 = 620;
const ax = (v: number) => AX0 + (v / 100) * (AX1 - AX0);
const ticks = [0, 25, 50, 75, 100];
const fmt = (v: number, digits = 1) => v.toFixed(digits);
---

<svg
  viewBox="0 0 640 262"
  role="img"
  aria-label={`A sample of ${n} from the population has mean ${fmt(mean, 2)}; inference estimates the population mean is between ${fmt(low)} and ${fmt(high)} with 95% confidence`}
  class="diagram"
>
  <defs>
    <marker
      id={`${id}-arrow`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="context-stroke"></path>
    </marker>
  </defs>

  <text x="0" y="14" class="title">Population</text>
  <text x="0" y="30" class="sub">mean μ unknown</text>
  <rect x="0" y="42" width="212" height="172" rx="6" class="panel"></rect>
  {
    Array.from({ length: COLS * ROWS }, (_, i) => (
      <circle
        cx={16 + (i % COLS) * 20}
        cy={58 + Math.floor(i / COLS) * 20}
        r={PICKED.has(i) ? 5 : 3.5}
        class:list={["person", { picked: PICKED.has(i) }]}
      />
    ))
  }

  <line
    x1="220"
    y1="92"
    x2="296"
    y2="92"
    marker-end={`url(#${id}-arrow)`}
    class="flow"></line>
  <text x="258" y="82" class="edge" text-anchor="middle">sample</text>
  <text x="258" y="108" class="edge" text-anchor="middle">n = {n}</text>

  <text x={AX0} y="14" class="title">Descriptive: summarize the sample</text>
  <text x={AX0} y="30" class="sub">
    x̄ = {fmt(mean, 2)} · s = {fmt(s, 2)}
  </text>
  <line x1={AX0} x2={AX1} y1="92" y2="92" class="axis"></line>
  {SAMPLE.map((v) => <circle cx={ax(v)} cy="92" r="5" class="person picked" />)}
  <line x1={ax(mean)} x2={ax(mean)} y1="70" y2="114" class="mean"></line>
  <text x={ax(mean)} y="64" class="edge" text-anchor="middle">x̄</text>

  <text x={AX0} y="152" class="title accent">
    Inferential: estimate the population
  </text>
  <text x={AX0} y="168" class="sub"> 95% confidence interval for μ </text>
  <line x1={AX0} x2={AX1} y1="206" y2="206" class="axis"></line>
  <line x1={ax(low)} x2={ax(high)} y1="206" y2="206" class="ci"></line>
  <line x1={ax(low)} x2={ax(low)} y1="198" y2="214" class="ci"></line>
  <line x1={ax(high)} x2={ax(high)} y1="198" y2="214" class="ci"></line>
  <circle cx={ax(mean)} cy="206" r="4" class="estimate"></circle>
  <text x={ax(low)} y="190" class="edge accent" text-anchor="middle">
    {fmt(low)}
  </text>
  <text x={ax(high)} y="190" class="edge accent" text-anchor="middle">
    {fmt(high)}
  </text>
  {
    ticks.map((t) => (
      <text x={ax(t)} y="232" class="tick">
        {t}
      </text>
    ))
  }

  <path
    d={`M ${AX0 - 8} 206 C 262 206, 262 190, 220 190`}
    marker-end={`url(#${id}-arrow)`}
    class="infer"></path>
  <text x="258" y="226" class="edge accent" text-anchor="middle">infer μ</text>
</svg>

<style>
  .diagram {
    min-width: 540px;
    color: var(--text-color);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .title {
    fill: currentColor;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }

  .sub,
  .tick {
    fill: var(--muted);
    font-size: 11px;
  }

  .tick {
    text-anchor: middle;
  }

  .panel {
    fill: none;
    stroke: var(--line);
  }

  .person {
    fill: var(--muted);
  }

  .person.picked {
    fill: currentColor;
  }

  .flow,
  .axis {
    stroke: var(--muted);
    stroke-width: 1.2;
  }

  .mean {
    stroke: currentColor;
    stroke-width: 2;
  }

  .edge {
    fill: var(--muted);
    font-size: 11px;
  }

  .ci {
    stroke: var(--contrast);
    stroke-width: 3;
  }

  .estimate {
    fill: var(--contrast);
  }

  .infer {
    fill: none;
    stroke: var(--contrast);
    stroke-width: 1.5;
  }

  .accent {
    fill: var(--contrast);
  }
</style>
