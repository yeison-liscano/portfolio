---
/**
 * DependencyInversion - Before, Notifier points down at concrete services.
 * After, every arrow points at the NotificationService abstraction.
 */
const id = "dip";
---

<svg
  viewBox="0 0 640 380"
  role="img"
  aria-label="Before: Notifier depends on EmailService and SMSService. After: Notifier and all three services depend on NotificationService"
  class="diagram"
>
  <defs>
    <marker
      id={`${id}-arrow`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="context-stroke"></path>
    </marker>
    <marker
      id={`${id}-triangle`}
      viewBox="0 0 12 12"
      refX="11"
      refY="6"
      markerWidth="11"
      markerHeight="11"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L12,6 L0,12 z" class="hollow"></path>
    </marker>
  </defs>

  <text x="0" y="14" class="title">
    Before: Notifier creates its services
  </text>
  <rect x="236" y="32" width="168" height="40" rx="4" class="box"></rect>
  <text x="320" y="52" class="label">
    Notifier
  </text>
  <rect x="96" y="120" width="168" height="40" rx="4" class="box"></rect>
  <text x="180" y="140" class="label">
    EmailService
  </text>
  <rect x="376" y="120" width="168" height="40" rx="4" class="box"></rect>
  <text x="460" y="140" class="label">
    SMSService
  </text>
  <line
    x1="290"
    y1="72"
    x2="200"
    y2="116"
    marker-end={`url(#${id}-arrow)`}
    class="depends"
  ></line>
  <line
    x1="350"
    y1="72"
    x2="440"
    y2="116"
    marker-end={`url(#${id}-arrow)`}
    class="depends"
  ></line>
  <text x="206" y="92" class="edge" text-anchor="end">
    creates
  </text>
  <text x="434" y="92" class="edge">
    creates
  </text>

  <line x1="0" y1="186" x2="640" y2="186" class="divider"></line>

  <text x="0" y="214" class="title">
    After: everything depends on the abstraction
  </text>
  <rect x="16" y="238" width="152" height="40" rx="4" class="box"></rect>
  <text x="92" y="258" class="label">
    Notifier
  </text>
  <rect
    x="236"
    y="238"
    width="200"
    height="40"
    rx="4"
    class="box abstract"
  ></rect>
  <text x="336" y="252" class="stereo">
    «abstract»
  </text>
  <text x="336" y="267" class="label">
    NotificationService
  </text>
  <line
    x1="168"
    y1="258"
    x2="232"
    y2="258"
    marker-end={`url(#${id}-arrow)`}
    class="depends"
  ></line>
  <text x="200" y="248" class="edge" text-anchor="middle">
    uses
  </text>

  <rect x="176" y="330" width="136" height="40" rx="4" class="box"></rect>
  <text x="244" y="350" class="label">
    EmailService
  </text>
  <rect x="324" y="330" width="120" height="40" rx="4" class="box"></rect>
  <text x="384" y="350" class="label">
    SMSService
  </text>
  <rect x="456" y="330" width="184" height="40" rx="4" class="box"></rect>
  <text x="548" y="350" class="label">
    PushNotificationService
  </text>
  <g class="inverted">
    <line
      x1="244"
      y1="330"
      x2="310"
      y2="286"
      marker-end={`url(#${id}-triangle)`}
    ></line>
    <line
      x1="384"
      y1="330"
      x2="350"
      y2="286"
      marker-end={`url(#${id}-triangle)`}
    ></line>
    <line
      x1="548"
      y1="330"
      x2="400"
      y2="284"
      marker-end={`url(#${id}-triangle)`}
    ></line>
    <text x="470" y="302" class="edge accent">
      implements
    </text>
  </g>
</svg>

<style>
  .diagram {
    min-width: 560px;
    color: var(--text-color);
    font-family: var(--font-mono);
  }

  .title {
    fill: currentColor;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }

  .box {
    fill: var(--code-background);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .box.abstract {
    stroke-dasharray: 5 3;
  }

  .label {
    fill: currentColor;
    font-size: 12px;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .stereo {
    fill: var(--muted);
    font-size: 10px;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .edge {
    fill: var(--muted);
    font-size: 11px;
  }

  .depends {
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .divider {
    stroke: var(--line);
    stroke-dasharray: 4 4;
  }

  .inverted line {
    stroke: var(--contrast);
    stroke-width: 1.5;
  }

  .hollow {
    fill: var(--surface);
    stroke: var(--contrast);
    stroke-width: 1.5;
  }

  .accent {
    fill: var(--contrast);
  }
</style>
