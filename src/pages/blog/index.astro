---
import Base from "layouts/Base.astro";
import PostPreview from "components/PostPreview.astro";
import { label, readingTime } from "../../utils/format";

import { getCollection } from "astro:content";

const allPosts = (
  await getCollection("blog", ({ data }) => !data.isDraft)
).sort((left, right) => {
  return right.data.pubDate.valueOf() - left.data.pubDate.valueOf();
});

const allTags = [...new Set(allPosts.flatMap(({ data }) => data.tags))].sort();
---

<Base
  title="Blog | Yeison Liscano"
  description="Articles on MCP servers, AI agents, application security, Python, algorithms and economics, with interactive diagrams and runnable examples."
>
  <div class="blog-header">
    <span class="eyebrow">THE BLOG</span>
    <h1>Ideas worth exploring.</h1>
    <p class="blog-subtitle">
      Notes on software, security, and the ideas behind them. Explore a topic,
      learn something new, and go a little deeper.
    </p>
  </div>
  <div class="search-bar">
    <label for="article-search">Find an article</label>
    <input
      id="article-search"
      type="search"
      placeholder="Search titles, topics, or descriptions…"
      autocomplete="off"
    />
    <p id="results-count" role="status" aria-live="polite">
      {allPosts.length} articles
    </p>
  </div>
  <div class="filter-bar" id="filter-bar">
    <button class="filter-btn active" data-tag="all" aria-pressed="true">
      All
    </button>
    {allTags.map((tag) => (
      <button class="filter-btn" data-tag={tag} aria-pressed="false">
        {label(tag)}
      </button>
    ))}
  </div>
  <div class="posts-container" id="posts-container">
    {allPosts.map(({ data, id, body }) => (
      <PostPreview
        title={data.title}
        pubDate={data.pubDate}
        description={data.description}
        tags={data.tags}
        slug={id}
        readingTime={data.readingTime ?? readingTime(body)}
        snippet={data.snippet}
        dataTags={data.tags.join(",")}
      />
    ))}
  </div>
  <p id="empty-results" hidden>
    No articles found. Try another search or topic.
  </p>
</Base>

<style>
  .blog-header,
  .search-bar,
  .filter-bar,
  .posts-container {
    width: 100%;
    max-width: 1000px;
  }
  .blog-header {
    padding: 16px 0 32px;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.15;
    margin: 14px 0 18px;
  }
  .blog-subtitle {
    max-width: 52ch;
    color: var(--muted);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .search-bar {
    margin: 8px 0 20px;
  }
  .search-bar label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 8px;
  }
  input {
    width: 100%;
    padding: 14px 16px;
    font: inherit;
    color: var(--text-color);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  input::placeholder {
    color: var(--muted);
  }
  #results-count {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 10px;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .filter-btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .filter-btn:hover,
  .filter-btn.active {
    color: var(--contrast);
    border-color: var(--contrast);
    background: var(--surface);
  }
  .posts-container {
    display: flex;
    flex-direction: column;
  }
  #empty-results {
    padding: 48px 0;
    color: var(--muted);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterBar = document.getElementById("filter-bar");
    const postsContainer = document.getElementById("posts-container");
    const posts = document.querySelectorAll<HTMLElement>(
      ".preview-container[data-tags]",
    );

    if (!filterBar || !postsContainer) return;

    const search = document.querySelector<HTMLInputElement>("#article-search");
    let selectedTag = "all";
    function filterByTag(tag: string) {
      selectedTag = tag;
      filterBar!.querySelectorAll(".filter-btn").forEach((b) => {
        const active = (b as HTMLElement).dataset.tag === tag;
        b.classList.toggle("active", active);
        b.setAttribute("aria-pressed", String(active));
      });

      const query = search?.value.trim().toLocaleLowerCase() ?? "";
      let count = 0;
      posts.forEach((post) => {
        const show =
          (tag === "all" ||
            (post.dataset.tags?.split(",") ?? []).includes(tag)) &&
          (post.querySelector(".description-container")?.textContent ?? "")
            .toLocaleLowerCase()
            .includes(query);
        if (show) count++;
        post.classList.toggle("visible", show);
        post.style.display = show ? "" : "none";
      });

      const status = document.getElementById("results-count");
      if (status)
        status.textContent = `${count} ${count === 1 ? "article" : "articles"}`;
      const empty = document.getElementById("empty-results");
      if (empty) empty.hidden = count > 0;
      const url = new URL(window.location.href);
      if (tag === "all") {
        url.searchParams.delete("tag");
      } else {
        url.searchParams.set("tag", tag);
      }
      window.history.replaceState({}, "", url);
    }

    filterBar.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        ".filter-btn",
      );
      if (!btn || !btn.dataset.tag) return;
      filterByTag(btn.dataset.tag);
    });

    postsContainer.addEventListener("click", (e) => {
      const tagBtn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-filter-tag]",
      );
      if (!tagBtn || !tagBtn.dataset.filterTag) return;
      filterByTag(tagBtn.dataset.filterTag);
    });

    search?.addEventListener("input", () => filterByTag(selectedTag));

    const allTagsFromButtons = () =>
      Array.from(filterBar.querySelectorAll<HTMLElement>("[data-tag]")).map(
        (button) => button.dataset.tag,
      );
    const initialTag = new URLSearchParams(window.location.search).get("tag");
    if (initialTag) {
      filterByTag(
        allTagsFromButtons().includes(initialTag) ? initialTag : "all",
      );
    }
  });
</script>
