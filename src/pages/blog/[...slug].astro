---
import Post from "layouts/Post.astro";
import { getCollection, render } from "astro:content";
import { readingTime } from "../../utils/format";
import { blogPostingSchema, person } from "../../utils/schema";
const { BASE_URL } = import.meta.env;

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.isDraft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      allPosts: posts,
    },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const nextPost = allPosts[(currentIndex + 1) % allPosts.length];
const previousPost =
  allPosts[(currentIndex - 1 + allPosts.length) % allPosts.length];

// Up to three posts that share the most tags, newest first on ties. The
// previous and next posts are already linked below, so they are left out.
const linked = new Set([post.id, previousPost.id, nextPost.id]);
const relatedPosts = allPosts
  .filter((p) => !linked.has(p.id))
  .map((p) => ({
    post: p,
    shared: p.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 3)
  .map(({ post }) => post);

// Rendered by src/pages/og/[slug].png.ts.
const image = `og/${post.id}.png`;
const jsonLd = blogPostingSchema(
  post,
  new URL(`${BASE_URL}blog/${post.id}/`, Astro.site).href,
  new URL(`${BASE_URL}${image}`, Astro.site).href,
);
---

<Post
  frontmatter={{
    ...post.data,
    readingTime: post.data.readingTime ?? readingTime(post.body),
  }}
  headings={headings}
  allPosts={allPosts}
  image={image}
  jsonLd={jsonLd}
>
  <Content />
  <nav class="next-post" aria-label="More articles">
    <aside class="author-box" aria-label="About the author">
      <p class="author-name">
        Written by{" "}
        <a href={`${BASE_URL}about/`} rel="author">
          {post.data.author}
        </a>
      </p>
      <p class="author-bio">
        {person.jobTitle} at {person.worksFor.name}, based in{" "}
        {person.address.addressLocality}.
      </p>
    </aside>
    {relatedPosts.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">Related articles</h2>
        <ul>
          {relatedPosts.map((related) => (
            <li>
              <a href={`${BASE_URL}blog/${related.id}/`}>
                {related.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {allPosts.length > 1 && (
      <a href={`${BASE_URL}blog/${previousPost.id}/`}>
        <span>← Previous article</span>
        {previousPost.data.title}
      </a>
    )}
    {allPosts.length > 2 && (
      <a href={`${BASE_URL}blog/${nextPost.id}/`}>
        <span>Next article →</span>
        {nextPost.data.title}
      </a>
    )}
    <a class="all-articles" href={`${BASE_URL}blog/`}>
      Browse all articles
    </a>
  </nav>
</Post>

<style>
  .next-post {
    display: grid;
    gap: 16px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .next-post > a {
    display: block;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text-color);
    font-weight: 500;
    line-height: 1.5;
  }
  .next-post > a:hover {
    border-color: var(--contrast);
  }
  .next-post span {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 10px;
    font-weight: 400;
  }
  .next-post .all-articles {
    grid-column: 1 / -1;
    border: none;
    background: transparent;
    padding: 8px 0;
    color: var(--contrast);
    font-size: 0.9rem;
  }
  .author-box,
  .related {
    grid-column: 1 / -1;
  }
  .author-box {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .author-name {
    font-weight: 600;
  }
  .author-name a,
  .author-name a:visited {
    color: var(--contrast);
  }
  .author-bio {
    color: var(--muted);
    font-size: 0.95rem;
  }
  :global(#post-article) .related h2 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }
  :global(#post-article) .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  :global(#post-article) .related li + li {
    margin-top: 0;
  }
  .related a,
  .related a:visited {
    color: var(--text-color);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .related a:hover {
    color: var(--contrast);
    text-decoration-color: currentColor;
  }
  @media (min-width: 720px) {
    .next-post {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
