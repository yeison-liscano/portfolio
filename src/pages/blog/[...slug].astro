---
import Post from "layouts/Post.astro";
import { getCollection, render } from "astro:content";
import { readingTime } from "../../utils/format";
import { blogPostingSchema } from "../../utils/schema";
const { BASE_URL } = import.meta.env;

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.isDraft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      allPosts: posts,
    },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const nextPost = allPosts[(currentIndex + 1) % allPosts.length];
const previousPost =
  allPosts[(currentIndex - 1 + allPosts.length) % allPosts.length];

// Rendered by src/pages/og/[slug].png.ts.
const image = `og/${post.id}.png`;
const jsonLd = blogPostingSchema(
  post,
  new URL(`${BASE_URL}blog/${post.id}/`, Astro.site).href,
  new URL(`${BASE_URL}${image}`, Astro.site).href,
);
---

<Post
  frontmatter={{
    ...post.data,
    readingTime: post.data.readingTime ?? readingTime(post.body),
  }}
  headings={headings}
  allPosts={allPosts}
  image={image}
  jsonLd={jsonLd}
>
  <Content />
  <nav class="next-post" aria-label="More articles">
    {allPosts.length > 1 && (
      <a href={`${BASE_URL}blog/${previousPost.id}/`}>
        <span>← Previous article</span>
        {previousPost.data.title}
      </a>
    )}
    {allPosts.length > 2 && (
      <a href={`${BASE_URL}blog/${nextPost.id}/`}>
        <span>Next article →</span>
        {nextPost.data.title}
      </a>
    )}
    <a class="all-articles" href={`${BASE_URL}blog/`}>
      Browse all articles
    </a>
  </nav>
</Post>

<style>
  .next-post {
    display: grid;
    gap: 16px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .next-post a {
    display: block;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text-color);
    font-weight: 500;
    line-height: 1.5;
  }
  .next-post a:hover {
    border-color: var(--contrast);
  }
  .next-post span {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 10px;
    font-weight: 400;
  }
  .next-post .all-articles {
    grid-column: 1 / -1;
    border: none;
    background: transparent;
    padding: 8px 0;
    color: var(--contrast);
    font-size: 0.9rem;
  }
  @media (min-width: 720px) {
    .next-post {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
