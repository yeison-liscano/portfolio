---
import type { CollectionEntry } from "astro:content";
import "../styles/base.css";
import Footer from "components/Footer.astro";
import Head from "components/Head.astro";
import Hero from "components/Hero.astro";
import TableOfContent from "components/TableOfContent.astro";
import Aside from "components/Aside.astro";
import PyodideRunner from "components/PyodideRunner.astro";

export interface Props {
  frontmatter: CollectionEntry<"blog">["data"];
  allPosts: CollectionEntry<"blog">[];
  headings: { slug: string; text: string; depth: number }[];
  /** Preview image path relative to the site base. */
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  frontmatter: { title, description, pubDate, readingTime, lang },
  headings,
  allPosts,
  image,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <Head
    title={`${title} | Yeison Liscano`}
    description={description}
    type="article"
    publishedTime={pubDate.toISOString()}
    lang={lang}
    image={image}
    jsonLd={jsonLd}
  />
  <body>
    <Aside posts={allPosts} />
    <div id="app-wrapper">
      <main id="main-content">
        <a class="back-link" href={`${import.meta.env.BASE_URL}blog/`}>
          ← All articles
        </a>
        <Hero
          pubDate={pubDate}
          readingTime={readingTime}
          description={description}
          title={title}
        >
          <TableOfContent headings={headings} />
        </Hero>
        <article id="post-article">
          <slot />
        </article>
      </main>
      <Footer />
    </div>
    <PyodideRunner />
  </body>
</html>

<style>
  .back-link {
    color: var(--muted);
    font-size: 0.85rem;
    width: fit-content;
  }
  .back-link:hover {
    color: var(--contrast);
  }
  #post-article {
    min-width: 0;
  }
  #post-article :global(h2) {
    font-size: 1.8rem;
    line-height: 1.3;
    margin-top: 28px;
    letter-spacing: -0.025em;
  }
  #post-article :global(h3) {
    font-size: 1.35rem;
    margin-top: 16px;
    line-height: 1.4;
  }
  #post-article :global(h2),
  #post-article :global(h3),
  #post-article :global(h4) {
    scroll-margin-top: 110px;
  }
  #post-article :global(ul),
  #post-article :global(ol) {
    padding-left: 1.4em;
    margin-left: 0;
  }
  #post-article :global(li + li) {
    margin-top: 0.5em;
  }
  #post-article :global(p a),
  #post-article :global(li a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #post-article :global(pre) {
    overflow-x: auto !important;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.85rem;
  }
  #post-article :global(p code),
  #post-article :global(li code) {
    background: var(--surface);
    border-radius: 4px;
    padding: 0.1em 0.3em;
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  #post-article :global(blockquote) {
    padding: 16px 20px;
    background: var(--surface);
    color: var(--muted);
    border-left-width: 2px;
  }
  #post-article :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  #post-article :global(th),
  #post-article :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  #app-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    transition: all 0.3s ease;
  }

  #main-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    padding: 20px;
    padding-top: 80px;
    margin: 0 auto;
    gap: 24px;
    transition: all 0.3s ease;
  }

  #post-article {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 1.0625rem;
    line-height: 1.75;
    width: 100%;
  }

  /* Keep running text near 70 characters; figures and code use the full column. */
  #post-article > :global(p),
  #post-article > :global(ul),
  #post-article > :global(ol),
  #post-article > :global(blockquote) {
    max-width: 70ch;
  }

  #post-article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 8px 0;
  }

  @media screen and (min-width: 720px) {
    #main-content {
      padding: 40px 40px;
      padding-top: 40px;
      gap: 40px;
    }

    #post-article {
      padding: 30px 0;
      gap: 28px;
    }
  }

  @media screen and (min-width: 900px) {
    #app-wrapper {
      margin-left: 0;
      width: 100%;
      padding-top: 80px;
    }

    #main-content {
      padding: 40px 60px;
      max-width: 860px;
    }

    #post-article {
      padding: 40px 0;
    }
  }

  @media screen and (min-width: 1300px) {
    #app-wrapper {
      margin-left: 0;
      margin-right: 350px;
      width: calc(100% - 350px);
      padding-top: 80px;
    }

    #main-content {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 56px;
    }

    #post-article {
      padding: 0;
      gap: 24px;
    }
  }
</style>
