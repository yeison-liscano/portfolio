---
import type { CollectionEntry } from "astro:content";
import "../styles/base.css";
import Footer from "components/Footer.astro";
import Head from "components/Head.astro";
import Hero from "components/Hero.astro";
import TableOfContent from "components/TableOfContent.astro";
import Aside from "components/Aside.astro";
import PyodideRunner from "components/PyodideRunner.astro";

export interface Props {
  frontmatter: CollectionEntry<"blog">["data"];
  allPosts: CollectionEntry<"blog">[];
  headings: { slug: string; text: string; depth: number }[];
  /** Preview image path relative to the site base. */
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  frontmatter: { title, description, pubDate, readingTime, lang },
  headings,
  allPosts,
  image,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <Head
    title={`${title} | Yeison Liscano`}
    description={description}
    type="article"
    publishedTime={pubDate.toISOString()}
    lang={lang}
    image={image}
    jsonLd={jsonLd}
  />
  <body>
    <Aside posts={allPosts} />
    <div id="app-wrapper">
      <main id="main-content">
        <a class="back-link" href={`${import.meta.env.BASE_URL}blog/`}>
          ← All articles
        </a>
        <Hero
          pubDate={pubDate}
          readingTime={readingTime}
          description={description}
          title={title}
        >
          <TableOfContent headings={headings} />
        </Hero>
        <article id="post-article">
          <slot />
        </article>
      </main>
      <Footer />
    </div>
    <div class="font-controls" role="group" aria-label="Text size">
      <button type="button" id="reading-mode" aria-pressed="false" aria-label="Reading mode" title="Reading mode (eye care)">☾</button>
      <button type="button" id="font-up" aria-label="Increase font size" title="Increase font size">A<sup>+</sup></button>
      <button type="button" id="font-down" aria-label="Reduce font size" title="Reduce font size">A<sup>-</sup></button>
    </div>
    <PyodideRunner />
  </body>
</html>

<script>
  // Reader-chosen text size, kept between visits. It scales #post-article via
  // the --post-scale custom property.
  const STEPS = [0.875, 1, 1.125, 1.25, 1.5];
  const KEY = "post-font-step";
  let step = 1;
  try {
    const saved = Number(localStorage.getItem(KEY));
    if (Number.isInteger(saved) && saved >= 0 && saved < STEPS.length) step = saved;
  } catch {}

  const up = document.getElementById("font-up") as HTMLButtonElement;
  const down = document.getElementById("font-down") as HTMLButtonElement;
  const applyStep = () => {
    document.documentElement.style.setProperty("--post-scale", String(STEPS[step]));
    up.disabled = step === STEPS.length - 1;
    down.disabled = step === 0;
    try {
      localStorage.setItem(KEY, String(step));
    } catch {}
  };
  up.addEventListener("click", () => {
    step = Math.min(step + 1, STEPS.length - 1);
    applyStep();
  });
  down.addEventListener("click", () => {
    step = Math.max(step - 1, 0);
    applyStep();
  });
  applyStep();

  // Reading mode: warm, low-contrast sepia palette to ease eye strain. It
  // pins the light theme underneath so code blocks and diagrams stay legible.
  const root = document.documentElement;
  const readingBtn = document.getElementById("reading-mode") as HTMLButtonElement;
  let themeBefore: string | null = null;
  const pinLight = () => {
    if (root.getAttribute("data-theme") !== "light") {
      root.setAttribute("data-theme", "light");
    }
  };
  const themeWatcher = new MutationObserver(pinLight);
  const setReading = (on: boolean) => {
    if (on) {
      themeBefore = root.getAttribute("data-theme");
      root.setAttribute("data-reading", "on");
      pinLight();
      themeWatcher.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    } else {
      themeWatcher.disconnect();
      root.removeAttribute("data-reading");
      if (themeBefore) root.setAttribute("data-theme", themeBefore);
    }
    readingBtn.setAttribute("aria-pressed", String(on));
    try {
      localStorage.setItem("post-reading-mode", on ? "1" : "0");
    } catch {}
  };
  readingBtn.addEventListener("click", () =>
    setReading(root.getAttribute("data-reading") !== "on"),
  );
  try {
    if (localStorage.getItem("post-reading-mode") === "1") setReading(true);
  } catch {}
</script>

<script>
  // Every Markdown table ships as a focusable, labelled region so it can be
  // scrolled with the keyboard even without JavaScript. Keep that only for
  // tables that overflow the column, so the rest are not extra tab stops.
  const fit = (box: HTMLElement) => {
    if (box.scrollWidth > box.clientWidth + 1) {
      box.setAttribute("tabindex", "0");
      box.setAttribute("role", "region");
      box.setAttribute("aria-label", box.dataset.tableLabel ?? "");
    } else {
      box.removeAttribute("tabindex");
      box.removeAttribute("role");
      box.removeAttribute("aria-label");
    }
  };

  const observer = new ResizeObserver((entries) => {
    entries.forEach((entry) => fit(entry.target as HTMLElement));
  });
  document
    .querySelectorAll<HTMLElement>("#post-article .table-scroll")
    .forEach((box) => observer.observe(box));
</script>

<style>
  .back-link {
    color: var(--muted);
    font-size: 0.85rem;
    width: fit-content;
  }
  .back-link:hover {
    color: var(--contrast);
  }
  #post-article {
    min-width: 0;
  }
  #post-article :global(h2) {
    font-size: calc(1.8rem * var(--post-scale, 1));
    line-height: 1.3;
    margin-top: 28px;
    letter-spacing: -0.025em;
  }
  #post-article :global(h3) {
    font-size: calc(1.35rem * var(--post-scale, 1));
    margin-top: 16px;
    line-height: 1.4;
  }
  #post-article :global(h2),
  #post-article :global(h3),
  #post-article :global(h4) {
    scroll-margin-top: 110px;
  }
  #post-article :global(ul),
  #post-article :global(ol) {
    padding-left: 1.4em;
    margin-left: 0;
  }
  #post-article :global(li + li) {
    margin-top: 0.5em;
  }
  #post-article :global(p a),
  #post-article :global(li a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #post-article :global(pre) {
    overflow-x: auto !important;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: calc(0.85rem * var(--post-scale, 1));
  }
  #post-article :global(p code),
  #post-article :global(li code) {
    background: var(--surface);
    border-radius: 4px;
    padding: 0.1em 0.3em;
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  #post-article :global(blockquote) {
    padding: 16px 20px;
    background: var(--surface);
    color: var(--muted);
    border-left-width: 2px;
  }
  /* Markdown tables arrive wrapped in .table-scroll (rehypeTableScroll). A
     wide table scrolls inside the column; the shadows at either edge show
     that more columns are hidden. Tables inside figures keep their own
     styles. */
  #post-article :global(.table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    --table-shadow: color-mix(in oklab, var(--text-color) 35%, transparent);
    background:
      linear-gradient(to right, var(--primary) 30%, transparent) left / 40px
        100% no-repeat local,
      linear-gradient(to left, var(--primary) 30%, transparent) right / 40px
        100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, var(--table-shadow), transparent)
        left / 16px 100% no-repeat scroll,
      radial-gradient(
          farthest-side at 100% 50%,
          var(--table-shadow),
          transparent
        )
        right / 16px 100% no-repeat scroll;
  }
  #post-article :global(.table-scroll:focus-visible) {
    outline: 2px solid var(--contrast);
    outline-offset: 2px;
  }
  #post-article :global(.table-scroll table) {
    border-collapse: collapse;
    font-size: calc(0.9rem * var(--post-scale, 1));
    font-variant-numeric: tabular-nums;
  }
  #post-article :global(.table-scroll :is(th, td)) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  /* Honor Markdown column alignment (| ---: |), which arrives as align. */
  #post-article :global(.table-scroll :is(th, td)[align="right"]) {
    text-align: right;
  }
  #post-article :global(.table-scroll :is(th, td)[align="center"]) {
    text-align: center;
  }
  .font-controls {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .font-controls button {
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--primary);
    color: var(--contrast);
    font-weight: 700;
    cursor: pointer;
  }
  .font-controls button:hover:not(:disabled) {
    border-color: var(--contrast);
  }
  .font-controls button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .font-controls button[aria-pressed="true"] {
    background: var(--contrast);
    color: var(--primary);
  }
  .font-controls sup {
    font-size: 0.6em;
  }
  :global(html:root[data-reading="on"]) {
    --primary: #f4ecd8;
    --secondary: #eadfc4;
    --neutral: #dccfae;
    --contrast: #8a4b12;
    --text-color: #433422;
    --code-background: #ece1c8;
    color-scheme: light;
  }
  :global(html:root[data-reading="on"] .astro-code-themes) {
    background-color: var(--code-background) !important;
  }
  #app-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    transition: all 0.3s ease;
  }

  #main-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    padding: 20px;
    padding-top: 80px;
    margin: 0 auto;
    gap: 24px;
    transition: all 0.3s ease;
  }

  #post-article {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: calc(1.0625rem * var(--post-scale, 1));
    line-height: 1.75;
    width: 100%;
  }

  /* Keep running text near 70 characters; figures and code use the full column. */
  #post-article > :global(p),
  #post-article > :global(ul),
  #post-article > :global(ol),
  #post-article > :global(blockquote) {
    max-width: 70ch;
  }

  #post-article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 8px 0;
  }

  @media screen and (max-width: 600px) {
    #post-article :global(.table-scroll :is(th, td)) {
      padding: 8px 12px;
    }
  }

  @media screen and (min-width: 720px) {
    #main-content {
      padding: 40px 40px;
      padding-top: 40px;
      gap: 40px;
    }

    #post-article {
      padding: 30px 0;
      gap: 28px;
    }
  }

  @media screen and (min-width: 900px) {
    #app-wrapper {
      margin-left: 0;
      width: 100%;
      padding-top: 80px;
    }

    #main-content {
      padding: 40px 60px;
      max-width: 860px;
    }

    #post-article {
      padding: 40px 0;
    }
  }

  @media screen and (min-width: 1300px) {
    #app-wrapper {
      margin-left: 0;
      margin-right: 350px;
      width: calc(100% - 350px);
      padding-top: 80px;
    }

    #main-content {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 56px;
    }

    #post-article {
      padding: 0;
      gap: 24px;
    }
  }
</style>
